CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_TOKEN=your_cloudflare_ai_token_here
MOTION_AI_CLOUDFLARE_PLAN=workers-free
MOTION_AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.group-ify.app,https://group-ify.app

GEMINI_API_KEY=your_gemini_api_key_here

# Invitation emails (Brevo, free plan): run `npm run setup:email`, or set these yourself. Server-only.
BREVO_API_KEY=YOUR_BREVO_API_KEY
INVITE_FROM_EMAIL=you@example.com
# Optional: the public site address used in invitation links
SITE_URL=https://group-ify.app

# Video calls in meetings (LiveKit Cloud, free plan): run `npm run setup:video`, or set these yourself. Server-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
